{
  "name": "Pacman AI Lab",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "python3 start_pacman.py install",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {"label": "Pacman AI Lab", "onAutoForward": "openBrowser", "protocol": "http"}
  },
  "customizations": {
    "vscode": {"extensions": ["ms-python.python", "GitHub.copilot-chat"]}
  }
}
